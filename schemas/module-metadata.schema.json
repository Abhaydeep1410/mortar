{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mortar.dev/schemas/module-metadata/v1.json",
  "title": "Mortar Module metadata.yaml v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "category", "display_name", "provides", "requires", "spring_boot", "java"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+(\\.[a-z-]+)+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "category": { "enum": ["authentication", "authorization", "observability", "data", "security", "deployment"] },
    "display_name": { "type": "string", "minLength": 1 },
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "interface": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
          "capability": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "capability": { "type": "string" },
          "env": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
        }
      }
    },
    "spring_boot": { "type": "string" },
    "java": { "type": "string" },
    "conflicts_with": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "owns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imports": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*\\.$" }
        }
      }
    }
  }
}
