<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.mortar</groupId>
  <artifactId>mortar-oracle</artifactId>
  <version>1.0.0</version>
  <name>mortar-oracle</name>
  <description>Black-box API oracles for the Mortar benchmark (docs/benchmark-design.md section 10)</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.3</junit.version>
    <!-- Which tagged tests to run: harness (no server needed, the default), or a prompt id such as crm-01 (needs the app running). -->
    <oracle.groups>harness</oracle.groups>
    <mortar.baseUrl>http://localhost:8080</mortar.baseUrl>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <groups>${oracle.groups}</groups>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Oracle.java</include>
          </includes>
          <systemPropertyVariables>
            <mortar.baseUrl>${mortar.baseUrl}</mortar.baseUrl>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
