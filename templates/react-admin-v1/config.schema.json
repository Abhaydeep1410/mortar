{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mortar.dev/schemas/templates/react-admin-v1/config.json",
  "title": "react-admin-v1 config (src/mortar.config.json)",
  "description": "The only file the Assembler writes. Derived from the blueprint: entities and kanban pages from `frontend`, roles from `roles`. Each entity's `path` is the URL segment of its REST endpoint and must match the backend.",
  "type": "object",
  "additionalProperties": false,
  "required": ["appName", "entities", "roles"],
  "properties": {
    "appName": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "resource", "fields"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "path": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "resource": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "oneOf": [
                { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "type"],
                  "properties": {
                    "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                    "type": { "enum": ["text", "longtext", "email", "number", "boolean", "date", "datetime"] }
                  }
                }
              ]
            }
          },
          "readOnly": { "type": "boolean" },
          "searchable": { "type": "boolean" },
          "exportable": { "type": "boolean" }
        }
      }
    },
    "kanban": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "groupBy"],
        "properties": {
          "entity": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "groupBy": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "columns": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "permissions"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(\\*|[a-z][a-z0-9_]*:(read|write|delete|export|\\*))$" }
          }
        }
      }
    }
  }
}
